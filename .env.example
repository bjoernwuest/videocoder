# Host paths
INPUT_PATH=/srv/videos/incoming
OUTPUT_PATH=/srv/videos/library
PUID=33
PGID=33

# Get a free key at https://www.omdbapi.com/apikey.aspx (empty = every file needs manual review)
OMDB_API_KEY=
# Basic Auth password for the web UI (empty = no auth)
UI_PASSWORD=

SCAN_INTERVAL=60
STABLE_MINUTES=5
SOURCE_RETENTION_DAYS=0
LANGUAGE_ORDER=ger,eng,chi,fre

# Encoding defaults (overridable per video in the UI)
VIDEO_ENCODER=libx265
QUALITY_FLAG=-crf
QUALITY=34
PRESET=medium
AUDIO_CODEC=copy
SUBTITLE_CODEC=dvdsub
FFMPEG_THREADS=
# e.g. Intel QSV: FFMPEG_INPUT_ARGS=-hwaccel qsv  VIDEO_ENCODER=hevc_qsv  QUALITY_FLAG=-global_quality
FFMPEG_INPUT_ARGS=
FFMPEG_OUTPUT_ARGS=
